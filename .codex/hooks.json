{
  "description": "OPLA local guardrails; requires native Codex hook trust. Not a sandbox.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$(git rev-parse --show-toplevel)/bin/opla-harness.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$(git rev-parse --show-toplevel)/bin/opla-harness.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$(git rev-parse --show-toplevel)/bin/opla-harness.py\" hook",
            "timeout": 5
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
